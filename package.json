{
    "name": "mageforge",
    "displayName": "MageForge",
    "description": "The official VS Code integration for the MageForge",
    "version": "0.2.0",
    "publisher": "OpenForgeProject",
    "icon": "resources/assets/logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/OpenForgeProject/mageforge-vscode"
    },
    "engines": {
        "vscode": "^1.125.0",
        "node": ">=24"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "workspaceContains:**/app/etc/env.php",
        "workspaceContains:**/registration.php",
        "onCommand:mageforge.template.overrideFile",
        "onView:mageforge.welcome",
        "onView:mageforge.commands",
        "onView:mageforge.themes"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "MageForge",
            "properties": {
                "mageforge.magentoRootPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Magento root directory (contains bin/magento). Defaults to the workspace folder.",
                    "order": 1
                },
                "mageforge.phpExecution": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "ddev",
                        "docker-compose",
                        "lando",
                        "local"
                    ],
                    "default": "auto",
                    "markdownDescription": "How to execute PHP commands. `auto` detects the environment from project files (`.ddev`, `docker-compose.yml`, `.lando.yml`).",
                    "order": 2
                },
                "mageforge.dockerComposeService": {
                    "type": "string",
                    "default": "php",
                    "description": "Docker Compose service name for PHP commands. Only used when `phpExecution` is `docker-compose`.",
                    "order": 3
                },
                "mageforge.phpBinary": {
                    "type": "string",
                    "default": "php",
                    "description": "PHP binary for local execution. Can be a full command like `docker-compose exec php` for custom setups.",
                    "order": 4
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "mageforge",
                    "title": "MageForge",
                    "icon": "resources/assets/MageForge-Logo.svg"
                }
            ]
        },
        "views": {
            "mageforge": [
                {
                    "type": "webview",
                    "id": "mageforge.welcome",
                    "name": "Welcome to MageForge",
                    "contextualTitle": "MageForge for Magento",
                    "icon": "resources/assets/MageForge-Logo.svg"
                },
                {
                    "id": "mageforge.commands",
                    "name": "Commands",
                    "icon": "resources/assets/MageForge-Logo.svg",
                    "contextualTitle": "MageForge"
                },
                {
                    "id": "mageforge.themes",
                    "name": "Themes",
                    "contextualTitle": "MageForge Themes"
                }
            ]
        },
        "commands": [
            {
                "command": "mageforge.theme.build",
                "title": "Theme: Build",
                "category": "MageForge",
                "icon": "$(tools)"
            },
            {
                "command": "mageforge.theme.watch",
                "title": "Theme: Watch",
                "category": "MageForge",
                "icon": "$(eye)"
            },
            {
                "command": "mageforge.theme.clean",
                "title": "Theme: Clean",
                "category": "MageForge",
                "icon": "$(trash)"
            },
            {
                "command": "mageforge.theme.list",
                "title": "Theme: List",
                "category": "MageForge",
                "icon": "$(list-unordered)"
            },
            {
                "command": "mageforge.theme.inspector",
                "title": "Theme: Inspector",
                "category": "MageForge",
                "icon": "$(search)"
            },
            {
                "command": "mageforge.hyva.tokens",
                "title": "Hyvä: Tokens",
                "category": "MageForge",
                "icon": "$(symbol-color)"
            },
            {
                "command": "mageforge.hyva.compatibilityCheck",
                "title": "Hyvä: Compatibility Check",
                "category": "MageForge",
                "icon": "$(checklist)"
            },
            {
                "command": "mageforge.template.override",
                "title": "Template: Override",
                "category": "MageForge",
                "icon": "$(copy)"
            },
            {
                "command": "mageforge.dependencies.update",
                "title": "Dependencies: Update",
                "category": "MageForge",
                "icon": "$(cloud-download)"
            },
            {
                "command": "mageforge.system.check",
                "title": "System: Check",
                "category": "MageForge",
                "icon": "$(pulse)"
            },
            {
                "command": "mageforge.system.version",
                "title": "System: Version",
                "category": "MageForge",
                "icon": "$(info)"
            },
            {
                "command": "mageforge.refreshThemes",
                "title": "Refresh Themes",
                "category": "MageForge",
                "icon": "$(refresh)"
            },
            {
                "command": "mageforge.template.overrideFile",
                "title": "Override File…",
                "category": "MageForge",
                "icon": "$(copy)"
            },
            {
                "command": "mageforge.showChangelog",
                "title": "Show Changelog",
                "category": "MageForge",
                "icon": "$(notebook-open-as-text)"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "mageforge.refreshThemes",
                    "when": "false"
                }
            ],
            "explorer/context": [
                {
                    "submenu": "mageforge.explorer",
                    "group": "mageforge",
                    "when": "mageforge.active"
                }
            ],
            "view/title": [
                {
                    "command": "mageforge.refreshThemes",
                    "when": "view == mageforge.themes",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "mageforge.theme.build",
                    "when": "view == mageforge.themes && viewItem == mageforgeTheme",
                    "group": "mageforge@1"
                },
                {
                    "command": "mageforge.theme.watch",
                    "when": "view == mageforge.themes && viewItem == mageforgeTheme",
                    "group": "mageforge@2"
                },
                {
                    "command": "mageforge.theme.clean",
                    "when": "view == mageforge.themes && viewItem == mageforgeTheme",
                    "group": "mageforge@3"
                }
            ],
            "mageforge.explorer": [
                {
                    "command": "mageforge.template.overrideFile",
                    "when": "!explorerResourceIsFolder",
                    "group": "mageforge@1"
                }
            ]
        },
        "submenus": [
            {
                "id": "mageforge.explorer",
                "label": "MageForge",
                "icon": "$(zap)"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vscode-test",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{json,md,yml,yaml,ts,js,mjs,cjs}": "prettier --write",
        "*.ts": "eslint --fix"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.13.3",
        "@types/vscode": "^1.125.0",
        "@typescript-eslint/eslint-plugin": "^8.17.0",
        "@typescript-eslint/parser": "^8.17.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^9.16.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "typescript": "^5.7.2"
    },
    "overrides": {
        "mocha": "^12.0.0-rc.6"
    }
}
